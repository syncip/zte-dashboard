# Kopieren nach .env und anpassen.
# Alles hier sind nur STARTWERTE: Was du später im Dashboard unter "Einstellungen" speicherst, hat Vorrang.
ZTE_HOST=http://192.168.168.1

# Router-Passwort (Admin-Login der Weboberfläche). Kann auch in den Dashboard-Einstellungen eingetragen werden.
# Ohne Passwort werden nur Signalwerte und Pings aufgezeichnet; Datenverbrauch und Verbindungs-Neustart brauchen es.
ZTE_PASSWORD=

# Optional: Passwort für das Dashboard selbst (wirkt nur beim ersten Start, solange noch kein Schutz eingerichtet ist).
# Später unter Einstellungen -> Sicherheit ändern. Vergessen? python zte_dash.py --reset-auth
ZTE_DASH_PASSWORD=

# Optional: Datenlimit in GB (0 = unbegrenzt, kein Limit-Hinweis) und Abrechnungstag (1-28).
# Bei Aldi Talk unlimited: 0 und 1 lassen (der Router setzt den Monatszähler am 1. zurück).
ZTE_MONTH_LIMIT_GB=0
ZTE_BILLING_DAY=1

# Optional
ZTE_POLL_SECONDS=10
ZTE_USAGE_SECONDS=10
# Rohmesswerte so viele Tage behalten; danach bleiben Stundenwerte DAUERHAFT erhalten
ZTE_RAW_DAYS=30
TZ=Europe/Berlin

# Ping-Ziele, Watchdog, Intervalle und Sicherheit werden im Dashboard eingestellt (Reiter "Einstellungen").
